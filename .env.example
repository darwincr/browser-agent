OPENCODE_A2A_VERSION=1.1.1

A2A_HOST_PORT=18000
OPENCODE_HOST_PORT=14096
VNC_HOST_PORT=5900
NOVNC_HOST_PORT=6080

A2A_PUBLIC_URL=http://localhost:18000
A2A_BROWSER_VIEW_URL=http://localhost:6080/vnc.html
OPENCODE_HOST=0.0.0.0
# OpenCode web UI/API basic auth. Leave the password empty to disable auth.
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=change-me
# Extra CORS origins allowed against the OpenCode server (space separated).
OPENCODE_CORS=https://browser-app.dranzone.net
OPENCODE_WORKSPACE_ROOT=/workspaces
OPENCODE_REFRESH_WORKSPACES_ON_START=false
A2A_ALLOW_DIRECTORY_OVERRIDE=true
A2A_STATIC_AUTH_CREDENTIALS=[{"scheme":"bearer","token":"change-me","principal":"local"}]

# Set this to require a VNC password. If omitted, VNC runs without a password.
# VNC_PASSWORD=change-me-too

VNC_GEOMETRY=1920x1080
VNC_DEPTH=24

# Max size for inline (base64) A2A file parts. 10 MiB.
A2A_FILE_MAX_INLINE_BYTES=10485760

# --- OpenCode provider secret (consumed by opencode.json via {env:...}) ---
# Required: backs the dr-openai LiteLLM provider.
LITELLM_API_KEY=change-me

XERO_USER=change-me
SECRET_XERO_PASSWORD=change-me

FACEBOOK_CLI_MESSENGER_PIN=123456
