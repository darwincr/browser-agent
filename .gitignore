# Local environment and secrets
.env
.env.*
!.env.example

# Runtime state
data/
artifacts/
workspaces/a2a-tasks/
workspaces/.seeded
workspaces/*/.git/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# OpenCode local state and dependencies
workspaces/*/.opencode/node_modules/
