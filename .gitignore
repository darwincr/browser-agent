# Logs and temporary files
*.log
logs/
tmp/
temp/
.DS_Store

# Build and coverage outputs
build/
dist/
.coverage
htmlcov/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/

# Node package caches
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
