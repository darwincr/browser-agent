{
  "$schema": "https://opencode.ai/config.json",
  "server": {
    "port": 4096,
    "hostname": "0.0.0.0",
    "cors": [
      "dranzone.net",
      "http://localhost:4096",
      "https://browser-app.dranzone.net"
    ]
  },
  "plugin": [
    "@tarquinen/opencode-smart-title"
  ],
  "default_agent": "build",
  "small_model": "dr-google/CLIProxyGemini/gemini-3.1-flash-lite",
  "autoupdate": true,
  "snapshot": false,
  "command": {
    "commit": {
      "description": "commit all changes",
      "template": "please commit and push all changes as a single commit"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8192
  },
  "provider": {
    "dr-anthropic": {
      "npm": "@ai-sdk/anthropic",
      "name": "DR Anthropic",
      "options": {
        "apiKey": "{env:LITELLM_API_KEY}",
        "baseURL": "https://litellm.dranzone.net/v1",
        "litellm": true,
        "modelFilter": [
          "CLIProxyAnthropic/*"
        ]
      },
      "models": {}
    },
    "dr-google": {
      "npm": "@ai-sdk/google",
      "name": "DR Google",
      "options": {
        "apiKey": "{env:LITELLM_API_KEY}",
        "baseURL": "https://litellm.dranzone.net/v1beta/models",
        "discoveryBaseURL": "https://litellm.dranzone.net",
        "litellm": true,
        "modelFilter": [
          "CLIProxyGemini/*"
        ]
      },
      "models": {}
    },
    "dr-openai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DR OpenAI",
      "options": {
        "apiKey": "{env:LITELLM_API_KEY}",
        "baseURL": "https://litellm.dranzone.net/",
        "litellm": true,
        "litellmMcp": true,
        "litellmMcpEnabled": false,
        "litellmMcpPrefix": "",
        "excludeMcpServers": [],
        "modelDefaults": [
          {
            "match": [
              "omlx/*"
            ],
            "exclude": [
              "omlx/*ASR*",
              "omlx/*TTS*",
              "omlx/*Embedding*",
              "omlx/whisper*",
              "omlx/fish-audio*",
              "omlx/MarkItDown"
            ],
            "model": {
              "attachment": true,
              "cost": {
                "input": 0,
                "output": 0
              },
              "limit": {
                "context": 131072,
                "output": 131072
              },
              "reasoning": true,
              "tool_call": true,
              "variants": {
                "low": {
                  "reasoningEffort": "low"
                },
                "medium": {
                  "reasoningEffort": "medium"
                },
                "high": {
                  "reasoningEffort": "high"
                },
                "max": {
                  "reasoningEffort": "max"
                },
                "none": {
                  "reasoningEffort": "none"
                },
                "xhigh": {
                  "reasoningEffort": "xhigh"
                }
              }
            }
          }
        ],
        "modelFilter": [
          "zai/*",
          "omlx/*",
          "azure/*",
          "moonshot/*",
          "minimax/*",
          "ollama-cloud/*",
          "cerebras/*",
          "sambanova/*",
          "ds4/*",
          "xai/*",
          "CLIProxy/gpt-*",
          "siliconflow/zai-org/*",
          "siliconflow/MiniMaxAI/*",
          "gemini/gemini-3.1-flash-lite"
        ],
        "setCacheKey": true
      },
      "models": {}
    }
  },
  "permission": {
    "question": "deny",
    "doom_loop": "deny",
    "external_directory": {
      "*": "deny",
      "/workspaces/a2a-tasks/**": "allow"
    },
    "skill": {
      "customize-opencode": "deny"
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "description": "Build",
      "model": "dr-openai/zai/glm-5.3",
      "temperature": 1,
      "permission": {
        "bash": {
          "*": "allow",
          "git push": "deny",
          "git push *": "deny"
        },
        "edit": "allow"
      },
      "options": {},
      "variant": "max"
    },
    "build1": {
      "mode": "primary",
      "description": "Build 1",
      "model": "dr-openai/CLIProxy/gpt-5.6-sol",
      "temperature": 1,
      "permission": {
        "bash": {
          "*": "allow",
          "git push": "deny",
          "git push *": "deny"
        },
        "edit": "allow"
      },
      "options": {},
      "variant": "xhigh"
    },
    "build2": {
      "mode": "primary",
      "description": "Build 2",
      "model": "dr-anthropic/CLIProxyAnthropic/claude-opus-5",
      "temperature": 1,
      "permission": {
        "bash": {
          "*": "allow",
          "git push": "deny",
          "git push *": "deny"
        },
        "edit": "allow"
      },
      "options": {},
      "variant": "xhigh"
    },
    "build3": {
      "mode": "primary",
      "description": "Build 3",
      "model": "dr-openai/CLIProxy/gpt-5.6-luna",
      "temperature": 1,
      "permission": {
        "bash": {
          "*": "allow",
          "git push": "deny",
          "git push *": "deny"
        },
        "edit": "allow"
      },
      "options": {},
      "variant": "xhigh"
    },
    "build4": {
      "mode": "primary",
      "description": "Build 4",
      "model": "dr-google/CLIProxyGemini/gemini-3.7-flash-high",
      "temperature": 1,
      "permission": {
        "bash": {
          "*": "allow",
          "git push": "deny",
          "git push *": "deny"
        },
        "edit": "allow"
      },
      "options": {},
      "variant": "high"
    },
    "plan": {
      "mode": "primary",
      "description": "Planning agent - GLM5.3",
      "model": "dr-openai/zai/glm-5.3",
      "temperature": 1,
      "tools": {
        "bash": false,
        "edit": false,
        "write": false
      },
      "options": {},
      "permission": {
        "bash": "deny",
        "edit": "deny"
      },
      "variant": "max"
    },
    "general": {
      "mode": "subagent",
      "description": "General-purpose agent for researching complex questions and executing multi-step tasks. Use this agent to execute multiple units of work in parallel.",
      "model": "dr-openai/zai/glm-5.3-flash",
      "temperature": 1,
      "steps": 10,
      "permission": {
        "todowrite": "deny"
      },
      "options": {},
      "variant": "high"
    },
    "explore": {
      "mode": "subagent",
      "description": "Fast agent specialized for exploring codebases. Use this when you need to quickly find files by patterns (eg. \"src/components/**/*.tsx\"), search code for keywords (eg. \"API endpoints\"), or answer questions about the codebase (eg. \"how do API endpoints work?\"). When calling this agent, specify the desired thoroughness level: \"quick\" for basic searches, \"medium\" for moderate exploration, or \"very thorough\" for comprehensive analysis across multiple locations and naming conventions.",
      "model": "dr-openai/zai/glm-5.3-flash",
      "temperature": 1,
      "permission": {
        "*": "deny",
        "bash": "allow",
        "external_directory": {
          "*": "deny"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "read": "allow",
        "webfetch": "deny",
        "websearch": "allow"
      },
      "options": {},
      "variant": "high"
    },
    "compaction": {
      "model": "dr-openai/zai/glm-5.3-flash",
      "variant": "high"
    }
  }
}
