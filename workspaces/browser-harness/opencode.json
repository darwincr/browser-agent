{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "external_directory": {
      "/tmp/**": "allow",
      "/home/opencode/.browser-harness/**": "allow"
    }
  }
}
